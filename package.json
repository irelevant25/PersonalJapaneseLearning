{
  "name": "japanese-academy",
  "version": "2.0.0",
  "private": true,
  "description": "Japanese Academy — WaniKani-style kanji SRS and a full course exam, with spoken vocabulary in two voices. PHP + PostgreSQL; Node runs only the browser tests and the PDF page tool.",
  "type": "commonjs",
  "scripts": {
    "start": "node tools/php.js server.php",
    "setup": "node tools/php.js setup.php",
    "test": "node tools/php.js tests/run.php && node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:browser": "node tests/browser/run.js",
    "screens": "node tests/browser/screens.js",
    "build": "node tools/php.js src/build-data.php",
    "build:audio": "node tools/php.js src/build-audio.php",
    "pdf:pages": "node tools/pdf/pages.js"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
